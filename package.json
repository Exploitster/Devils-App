{
  "name": "devils-advocate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev --hostname 127.0.0.1",
    "dev:local": "NODE_USE_ENV_PROXY=1 DEVILS_RUNTIME_MODE=local DEVILS_SQLITE_PATH=.local/devils.sqlite next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "NODE_USE_ENV_PROXY=1 next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evidence:verify": "tsx scripts/evidence-import.ts --verify",
    "eval": "tsx tests/evaluations/run.ts",
    "eval:live": "NODE_USE_ENV_PROXY=1 tsx tests/evaluations/live.ts",
    "test:openrouter": "NODE_USE_ENV_PROXY=1 tsx scripts/verify-openrouter.ts",
    "test:supabase": "NODE_USE_ENV_PROXY=1 tsx scripts/verify-supabase.ts",
    "setup:local": "node scripts/local-setup.mjs",
    "test:db": "node scripts/test-postgres.mjs",
    "db:setup:bundle": "node scripts/build-supabase-setup.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "vitest": "5.0.0",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.11.0",
    "tsx": "4.21.0"
  },
  "type": "module"
}
