# Service mode is the default. Never use local mode in production.
DEVILS_RUNTIME_MODE=services
DEVILS_APP_URL=http://127.0.0.1:3000
DEVILS_LAUNCH_DATE=2026-12-01
DEVILS_BETA_ACTIVE=false
DEVILS_GENERATION_TIMEOUT_MS=30000
DEVILS_DAILY_SPEND_LIMIT_MICROS=5000000
# Local development: npm run setup:local creates this in ignored .env.local.
DEVILS_LOCAL_AUTH_SECRET=
DEVILS_SQLITE_PATH=.local/devils.sqlite
# Configure all service bindings securely; do not put them in browser env variables.
DEVILS_SUPABASE_URL=
DEVILS_SUPABASE_ANON_KEY=
DEVILS_SUPABASE_SERVICE_ROLE_KEY=
DEVILS_GEMINI_API_KEY=
# Explicit provider selection. Existing Gemini settings are retained for rollback.
DEVILS_MODEL_PROVIDER=gemini
DEVILS_OPENROUTER_API_KEY=
DEVILS_OPENROUTER_MODEL=google/gemini-2.5-flash
DEVILS_OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-4.5
# Enforced OpenRouter endpoint price caps, USD per million text tokens.
# These are separate from Gemini rates. Do not raise automatically after a tariff change.
DEVILS_OPENROUTER_MAX_INPUT_USD_PER_MILLION=1
DEVILS_OPENROUTER_MAX_OUTPUT_USD_PER_MILLION=5
DEVILS_MODEL=gemini-3.8-flash
# Explicit current-model prices are required in services mode; consult provider pricing.
DEVILS_MODEL_INPUT_USD_PER_MILLION=
DEVILS_MODEL_OUTPUT_USD_PER_MILLION=
DEVILS_MAX_OUTPUT_TOKENS=2500
# Payments are deferred. Leave disabled and leave Stripe fields empty.
DEVILS_PAYMENTS_ENABLED=false
# Future integration: only Stripe TEST credentials are accepted. The webhook secret is verified server-side.
DEVILS_STRIPE_SECRET_KEY=
DEVILS_STRIPE_WEBHOOK_SECRET=
DEVILS_STRIPE_MONTHLY_PRICE_ID=
DEVILS_STRIPE_YEARLY_PRICE_ID=

# Optional Vercel AI Gateway (server-only). Hosted deployments use Vercel OIDC.
# DEVILS_MODEL_PROVIDER=gateway
# AI_GATEWAY_API_KEY=   # local development only; do not replace existing provider keys
# DEVILS_GATEWAY_MODEL=google/gemini-2.5-flash
